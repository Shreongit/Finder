<Window x:Class="Finder.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Finder.App.Views"
        Title="Finder"
        Icon="pack://application:,,,/Assets/Icons/Finder.ico"
        Width="640"
        Height="150"
        MinWidth="560"
        MaxWidth="680"
        MinHeight="126"
        MaxHeight="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="SearchWindow_Deactivated"
        WindowStartupLocation="Manual"
        AutomationProperties.Name="Finder search">

    <Window.Resources>
        <views:SearchResultIconConverter x:Key="SearchResultIconConverter" />
    </Window.Resources>

    <Border Margin="12"
            Background="{DynamicResource FinderBackgroundBrush}"
            BorderBrush="{DynamicResource FinderBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource FinderShadowColor}" BlurRadius="20" ShadowDepth="3" Opacity="0.2" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="6,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="17"
                           Foreground="{DynamicResource FinderMutedTextBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />

                <TextBox x:Name="SearchInput"
                         Grid.Column="1"
                         Style="{StaticResource FinderSearchTextBox}"
                         VerticalAlignment="Center"
                         ToolTip="Find anything with Finder"
                         AutomationProperties.Name="Finder search"
                         TextChanged="SearchInput_TextChanged"
                         KeyDown="SearchInput_KeyDown" />

                <TextBlock x:Name="PlaceholderText"
                           Grid.Column="1"
                           Text="Find anything with Finder"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="18"
                           Foreground="{DynamicResource FinderPlaceholderBrush}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Visible" />

                <Border Grid.Column="2"
                        Padding="7,3"
                        Margin="10,0,0,0"
                        CornerRadius="5"
                        BorderBrush="{DynamicResource FinderBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="ESC" FontSize="10" Foreground="{DynamicResource FinderMutedTextBrush}" />
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock x:Name="EmptyStateText"
                           Text="Start typing to find apps, files, settings and more"
                           FontSize="13"
                           Foreground="{DynamicResource FinderMutedTextBrush}"
                           Margin="42,2,0,4"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <ListBox x:Name="ResultsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource FinderTextBrush}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Single"
                         ItemContainerStyle="{StaticResource FinderResultItem}"
                         SelectionChanged="ResultsList_SelectionChanged"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         Visibility="Collapsed">
                    <ListBox.Resources>
                        <!-- Keep the ScrollViewer active for wheel and keyboard scrolling while
                             removing the scrollbar's visual and its reserved layout column. -->
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="30" Height="30" VerticalAlignment="Center">
                                    <TextBlock x:Name="FallbackIcon"
                                               Text="&#xE8D4;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{DynamicResource FinderMutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding Converter={StaticResource SearchResultIconConverter}}"
                                           Width="30" Height="30" Stretch="Uniform" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource FinderMutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Kind}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource FinderMutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,3,0" />
                            </Grid>
                            <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Settings">
                                        <Setter TargetName="FallbackIcon" Property="Text" Value="&#xE713;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Web">
                                        <Setter TargetName="FallbackIcon" Property="Text" Value="&#xE774;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                        <Setter TargetName="FallbackIcon" Property="Text" Value="&#xE8B7;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="File">
                                        <Setter TargetName="FallbackIcon" Property="Text" Value="&#xE8A5;" />
                                    </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</Window>
