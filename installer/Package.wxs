<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Finder"
           Manufacturer="Finder"
           Version="$(var.ProductVersion)"
           UpgradeCode="A5A6FAD6-F2E5-4C9A-AE3D-6BE7C7379A29"
           Scope="perUser"
           InstallerVersion="500"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Finder is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_Minimal" />

    <Icon Id="FinderIcon" SourceFile="$(var.FinderIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FinderIcon" />
    <Property Id="AUTOSTART" Value="1" Secure="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="FinderProgramsFolder" Name="Programs">
        <Component Id="RemoveFinderProgramsFolder" Guid="C630C292-4525-53F9-A8A0-0957DA43F684">
          <RegistryValue Root="HKCU" Key="Software\Finder\Installer" Name="ProgramsFolder" Type="integer" Value="1" KeyPath="yes" />
          <RemoveFolder Id="RemoveFinderProgramsFolderOnUninstall" Directory="FinderProgramsFolder" On="uninstall" />
        </Component>
        <Directory Id="FinderInstallFolder" Name="Finder">
          <Component Id="RemoveFinderInstallFolder" Guid="B72AB62B-5394-50FE-A01A-3AF84E5D0913">
            <RegistryValue Root="HKCU" Key="Software\Finder\Installer" Name="InstallFolder" Type="integer" Value="1" KeyPath="yes" />
            <RemoveFolder Id="RemoveFinderInstallFolderOnUninstall" Directory="FinderInstallFolder" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="FinderStartMenuFolder" Name="Finder" />
    </StandardDirectory>
    <StandardDirectory Id="StartupFolder">
      <Directory Id="FinderStartupFolder" Name="Finder" />
    </StandardDirectory>

    <Feature Id="FinderFeature" Title="Finder" Level="1">
      <ComponentGroupRef Id="FinderPayload" />
      <ComponentRef Id="RemoveFinderProgramsFolder" />
      <ComponentRef Id="RemoveFinderInstallFolder" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="StartupShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <DirectoryRef Id="FinderStartMenuFolder">
      <Component Id="StartMenuShortcut" Guid="B3B8A1E5-20AC-5328-AD07-9B7FEC1D4A24">
        <RegistryValue Root="HKCU" Key="Software\Finder\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="FinderStartMenuLink" Name="Finder" Target="[FinderInstallFolder]Finder.App.exe" WorkingDirectory="FinderInstallFolder" Icon="FinderIcon" />
        <RemoveFolder Id="RemoveFinderStartMenuFolder" Directory="FinderStartMenuFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="FinderStartupFolder">
      <Component Id="StartupShortcut" Guid="FCBE73AF-8952-52B5-A45C-AF655F1B3581" Condition="AUTOSTART = &quot;1&quot;">
        <RegistryValue Root="HKCU" Key="Software\Finder\Installer" Name="StartupShortcut" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="FinderStartupLink" Name="Finder" Target="[FinderInstallFolder]Finder.App.exe" WorkingDirectory="FinderInstallFolder" Icon="FinderIcon" />
        <RemoveFolder Id="RemoveFinderStartupFolder" Directory="FinderStartupFolder" On="uninstall" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
